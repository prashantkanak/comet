# LLM provider: mock | openai | gemini
LLM_PROVIDER=mock

# Provider-specific model (examples)
# MODEL_NAME=gpt-4o-mini
# MODEL_NAME=gemini-2.5-flash

# API keys (required only when using the matching provider)
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Paths and runtime
# INPUT_DIR=data
# OUTPUT_DIR=output
# LOG_LEVEL=INFO
# MAX_LLM_ATTEMPTS=2

# Manual real-provider smoke test (never required for pytest by default)
# COMET_LIVE_LLM=1
