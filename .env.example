# LLM provider: mock | openai | gemini | groq
LLM_PROVIDER=mock

# Provider-specific model (examples)
# MODEL_NAME=gpt-4o-mini
# MODEL_NAME=gemini-2.5-flash
# MODEL_NAME=qwen/qwen3.8-27b

# API keys (required only when using the matching provider)
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=

# Paths and runtime
# INPUT_DIR=data
# OUTPUT_DIR=output
# LOG_LEVEL=INFO
# MAX_LLM_ATTEMPTS=2

# Manual real-provider smoke test (never required for pytest by default)
# COMET_LIVE_LLM=1

# Streamlit frontend → Vercel (or local) FastAPI
# COMET_API_URL=http://127.0.0.1:8000
# COMET_CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
